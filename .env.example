# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit a real .env file – it is already in .gitignore.

# From Cloudinary → Dashboard (top of the page)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# The password you type at yoursite.com/admin
ADMIN_PASSWORD=choose-a-long-password

# Any long random text (keeps admin sign-ins secure). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Optional: Vercel → Settings → Git → Deploy Hooks. Saving in the admin panel then
# automatically rebuilds the property pages and sitemap.
VERCEL_DEPLOY_HOOK_URL=

# Optional: overrides siteUrl in config.js
SITE_URL=
